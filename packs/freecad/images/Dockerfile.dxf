# Maintainer build only. End users pull the immutable published image.
# Context is prepared by scripts/build-dxf-runtime.py from the hash-locked wheels.
FROM python:3.13.12-slim-bookworm@sha256:a58daefb915e1e03ad48f3ca4df8832065412c5c35cacb9d39f4229184de12b6
COPY site /usr/local/lib/python3.13/site-packages
COPY dxf-native.py /opt/cad/dxf-native.py
COPY dxf-requirements.txt /opt/cad/dxf-requirements.txt
RUN python3 -I -c 'import sys,ezdxf; assert sys.version_info[:3] == (3,13,12); assert ezdxf.__version__ == "1.4.3"'
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /work
ENTRYPOINT ["python3", "-I", "/opt/cad/dxf-native.py"]
LABEL org.opencontainers.image.title="Industrial CAD DXF Runtime" \
      org.opencontainers.image.source="https://github.com/Zhiman-BJ/industrial-domain-packs" \
      tech.zhiman.cad.ezdxf-version="1.4.3"
