{
  "schemaVersion": 1,
  "policy": "Container images are published from this repository's digest-pinned recipes to ghcr.io (lowercase namespace) and attached to the matching GitHub Release as compressed oci-archive tarballs. Anonymous pull and download are the default; the org Harbor stays internal-only. Entries are updated only by scripts/update-runtime-distribution.py from a release workflow run; never hand-edit a digest.",
  "registry": "ghcr.io",
  "imageNamespace": "zhiman-bj",
  "releaseAssetUrlTemplate": "https://github.com/Zhiman-BJ/industrial-domain-packs/releases/download/{tag}/{archive}",
  "registryManifestUrlTemplate": "https://ghcr.io/v2/{namespace}/{repository}/manifests/{digest}",
  "images": [
    {
      "id": "industrial-pcb-runtime",
      "pack": "pcb",
      "repository": "industrial-pcb-runtime",
      "recipe": "packs/pcb/Dockerfile.local-dev",
      "context": "packs/pcb",
      "platform": "linux/amd64",
      "tagPattern": "pcb-v*",
      "current": null
    },
    {
      "id": "industrial-chip-tools",
      "pack": "chip",
      "repository": "industrial-chip-tools",
      "recipe": "packs/chip/eda-harness/Dockerfile.tools",
      "context": "packs/chip/eda-harness",
      "platform": "linux/amd64",
      "tagPattern": "chip-v*",
      "current": null
    },
    {
      "id": "industrial-chip-rtl",
      "pack": "chip",
      "repository": "industrial-chip-rtl",
      "recipe": "packs/chip/images/Dockerfile.rtl-cpu",
      "context": "packs/chip",
      "platform": "linux/amd64",
      "tagPattern": "chip-v*",
      "current": null
    }
  ]
}
